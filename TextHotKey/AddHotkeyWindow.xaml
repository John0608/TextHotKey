<Window x:Class="TextHotKey.AddHotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="단축키 추가"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <!-- DialogHost(Popup) 대신 실제 Window를 써서 한글 IME 조합이 정상 동작하게 한다. -->
    <StackPanel Margin="16">
        <TextBlock Text="단축키 추가"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,16"/>

        <TextBox x:Name="HotkeyBox"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="클릭 후 단축키를 누르세요"
                 IsReadOnly="True"
                 Margin="0,0,0,8"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

        <TextBox x:Name="InputTextBox"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="입력될 텍스트"
                 Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="추가"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsDefault="True"
                    Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
