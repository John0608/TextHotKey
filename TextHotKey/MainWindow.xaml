<ui:FluentWindow x:Class="TextHotKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TextHotKey"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="TextHotKey"
        Height="620" Width="400"
        MinHeight="480" MinWidth="360"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Icon="/favicon.ico">

    <ui:FluentWindow.Resources>
        <local:HotkeyToKeysConverter x:Key="HotkeyToKeys" />

        <!-- 키캡 칩 -->
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 섹션 라벨 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="2,0,2,6" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 타이틀바 (드래그·스냅·네이티브 버튼은 WPF-UI가 처리) -->
        <!-- 최소화·닫기도 테마 버튼과 같은 커스텀 스타일로 통일(네이티브 캡션 버튼 숨김). -->
        <ui:TitleBar Grid.Row="0" Title="TextHotKey"
                     ShowMaximize="False" CanMaximize="False"
                     ShowMinimize="False" ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button x:Name="ThemeToggleButton"
                               Appearance="Transparent" Padding="9,5" Margin="0,0,8,0"
                               Click="ThemeToggleButton_Click" ToolTip="라이트/다크 전환">
                        <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherSunny24" FontSize="16" />
                    </ui:Button>

                    <!-- 최소화·닫기를 라운드 박스 하나에 묶고, 세로 가운데 + 위아래 여백 -->
                    <Border CornerRadius="8" ClipToBounds="True"
                            VerticalAlignment="Center" Margin="0,5,0,5"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="MinimizeButton"
                                       Appearance="Transparent" CornerRadius="0" Padding="10,5" Margin="0"
                                       Click="MinimizeButton_Click" ToolTip="최소화">
                                <ui:SymbolIcon Symbol="Subtract24" FontSize="16" />
                            </ui:Button>
                            <ui:Button x:Name="CloseButton"
                                       Appearance="Transparent" CornerRadius="0" Padding="10,5" Margin="0"
                                       MouseOverBackground="#C42B1C"
                                       Click="CloseButton_Click" ToolTip="닫기">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ============ 단축키 화면 (메인) ============ -->
        <Grid x:Name="HotkeysView" Grid.Row="1" Margin="14,4,14,8" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 활성화 카드 -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="단축키 활성화" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="StatusPill"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                             Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="ActivateStatusText" Text="중지됨"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="전역에서 단축키 감지"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" x:Name="ActivateToggle"
                                     VerticalAlignment="Center"
                                     Checked="ActivateToggle_Checked"
                                     Unchecked="ActivateToggle_Unchecked" />
                </Grid>
            </ui:Card>

            <!-- 목록 헤더 -->
            <Grid Grid.Row="1" Margin="2,0,2,8">
                <TextBlock Text="내 단축키" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left" />
                <TextBlock x:Name="CountText" Text="0개"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12" HorizontalAlignment="Right" />
            </Grid>

            <!-- 목록 -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HotkeyItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="11,7" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ItemsControl Grid.Column="0" VerticalAlignment="Center"
                                                      ItemsSource="{Binding Hotkey, Converter={StaticResource HotkeyToKeys}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Keycap}">
                                                        <TextBlock Text="{Binding}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   Margin="11,0,8,0" VerticalAlignment="Center"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text}" />

                                        <ui:Button Grid.Column="2" Appearance="Transparent"
                                                   Padding="6" Click="DeleteButton_Click"
                                                   Tag="{Binding}" ToolTip="삭제">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="+ 새 단축키로 시작하세요"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>

            <!-- 새 단축키 (배경색은 코드에서 테마별로 지정) -->
            <ui:Button Grid.Row="3" x:Name="AddButton"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Margin="0,12,0,0" Padding="0,9"
                       Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                    <TextBlock Text="새 단축키" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <!-- ============ 설정 화면 ============ -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="1"
                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,4,14,8">

                <TextBlock Text="일반" Style="{StaticResource SectionLabel}" />
                <ui:Card Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="윈도우 시작 시 자동 실행"
                                       FontSize="13" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Column="1" x:Name="AutoStartToggle"
                                             Checked="AutoStartToggle_Checked"
                                             Unchecked="AutoStartToggle_Unchecked" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="시작 시 자동 업데이트 확인"
                                       FontSize="13" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Column="1" x:Name="AutoUpdateToggle"
                                             Checked="AutoUpdateToggle_Checked"
                                             Unchecked="AutoUpdateToggle_Unchecked" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="업데이트" FontSize="13" />
                                <TextBlock x:Name="UpdateStatusText" Text="현재 버전 확인 중…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11.5" Margin="0,1,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="업데이트 확인"
                                       VerticalAlignment="Center" Click="CheckUpdateButton_Click" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="테스트(베타) 프로그램" Style="{StaticResource SectionLabel}" />
                <ui:Card>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="참가 코드"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="11.5" />
                                <TextBlock x:Name="BetaCodeText" Text="TH-000000"
                                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="BetaStatusPill"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                                <TextBlock x:Name="BetaStatusText" Text="확인 전"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="BetaEmailBox"
                                        PlaceholderText="이메일 (선택)" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="신청" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Click="BetaRequestButton_Click" />
                        </Grid>

                        <TextBlock Text="신청 후 오너 승인이 되면 베타 버전을 받을 수 있어요."
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <ui:Button Content="승인 상태 새로고침" Appearance="Transparent"
                                   Padding="6,3" Margin="0,4,0,0" FontSize="12"
                                   HorizontalAlignment="Left" Click="BetaRefreshButton_Click" />

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="테스트(베타) 버전 받기" FontSize="13" />
                                <TextBlock Text="승인된 기기에서만 활성화"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11.5" Margin="0,1,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="BetaUpdateToggle"
                                             IsEnabled="False"
                                             Checked="BetaUpdateToggle_Checked"
                                             Unchecked="BetaUpdateToggle_Unchecked" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 하단 탭 ============ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <ui:Button x:Name="HotkeysTabButton"
                               Appearance="Transparent" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Height="54"
                               Click="HotkeysTab_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Keyboard24" HorizontalAlignment="Center" />
                            <TextBlock Text="단축키" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </ui:Button>
                    <Border x:Name="HotkeysTabBar" Height="3" Width="28" CornerRadius="2"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                </Grid>

                <Grid Grid.Column="1">
                    <ui:Button x:Name="SettingsTabButton"
                               Appearance="Transparent" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Height="54"
                               Click="SettingsTab_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Settings24" HorizontalAlignment="Center" />
                            <TextBlock Text="설정" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </ui:Button>
                    <Border x:Name="SettingsTabBar" Height="3" Width="28" CornerRadius="2"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
